# ExecuteIt Frontend Environment Variables

# Backend API Base URL (Used when connecting to the live Express/Node.js backend)
VITE_API_BASE_URL=http://localhost:3000/api

# Mock Mode Configuration:
# - 'true': Always use local mock services and sample data (default for client demo)
# - 'false': Send actual HTTP requests to VITE_API_BASE_URL with graceful fallback if unreachable
VITE_USE_MOCK=true

# Application Name & Version
VITE_APP_NAME=ExecuteIt
VITE_APP_VERSION=1.0.0
